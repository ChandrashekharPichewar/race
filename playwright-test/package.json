{
  "name": "race-playwright-test",
  "version": "1.0.0",
  "private": true,
  "description": "Enterprise Playwright POM automation test suite for Race Ridesharing App",
  "scripts": {
    "test": "playwright test",
    "test:smoke": "playwright test --grep @smoke",
    "test:regression": "playwright test --grep @regression",
    "test:auth": "playwright test --grep @auth",
    "test:private": "playwright test --grep @private",
    "test:api": "playwright test --grep @api",
    "test:ui": "playwright test --ui",
    "test:headed": "playwright test --headed",
    "test:list": "playwright test --list",
    "typecheck": "tsc --noEmit",
    "report": "playwright show-report"
  },
  "devDependencies": {
    "@playwright/test": "^1.49.0",
    "@types/node": "^22.10.0",
    "typescript": "^5.6.3"
  }
}
